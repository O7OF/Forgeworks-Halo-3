<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ForgeWorks.UI.ViewModels"
        xmlns:tags="using:ForgeWorks.Blam.Tags"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Width="1100" Height="750" MinWidth="500" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        x:Class="ForgeWorks.UI.Views.TagEditorWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding ActiveTagDocument.FilePath, StringFormat='Guerilla Tag Editor - {0}', FallbackValue='Guerilla Tag Editor'}"
        Background="#14161a">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="Button > TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#0f1013"/>
            <Setter Property="Foreground" Value="#e4e4e7"/>
            <Setter Property="BorderBrush" Value="#272b34"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Foreground" Value="#9ca3af"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="#38bdf8"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 1. GUERILLA HEADER BAR -->
        <Border Grid.Row="0" Background="#1c1f26" BorderBrush="#282d38" BorderThickness="0,0,0,1" Padding="12,8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,4">
                    <Border Background="#0284c7" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="{Binding ActiveTagDocument.TagGroupMagic, FallbackValue='scnr'}" FontWeight="Bold" FontSize="11" Foreground="White"/>
                    </Border>
                    <TextBlock Text="GUERILLA TAG EDITOR" FontWeight="Bold" FontSize="13" Foreground="#f8fafc" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ActiveTagDocument.FilePath}" FontSize="11" Foreground="#94a3b8" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                </StackPanel>

                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                    <Button Command="{Binding RefreshGuerillaTagDocumentCommand}" Background="#27272a" Foreground="#e4e4e7" Margin="0,0,8,0">
                        <TextBlock Text="🔄 Reload"/>
                    </Button>
                    <Button Command="{Binding SaveScenarioTagCommand}" Background="#059669" Foreground="White" FontWeight="Bold">
                        <TextBlock Text="💾 Save / Commit Tag"/>
                    </Button>
                </WrapPanel>
            </WrapPanel>
        </Border>

        <!-- 2. MAIN GUERILLA TAG BODY TABS -->
        <TabControl Grid.Row="1" Margin="8">
            <!-- TAB 1: TAG HEADER FIELDS & STRUCTS -->
            <TabItem Header="📋 Tag Header Fields">
                <Grid RowDefinitions="Auto,*" Margin="4">
                    <Border Grid.Row="0" Background="#181b22" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,*,*,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Magic Group:" FontSize="10" Foreground="#64748b"/>
                                <TextBlock Text="{Binding ActiveTagDocument.TagGroupMagic}" FontWeight="Bold" FontSize="12" Foreground="#38bdf8"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Engine Checksum:" FontSize="10" Foreground="#64748b"/>
                                <TextBlock Text="{Binding ActiveTagDocument.EngineChecksum, StringFormat='0x{0:X8}'}" FontWeight="Bold" FontSize="12" Foreground="#4ade80"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Header Size:" FontSize="10" Foreground="#64748b"/>
                                <TextBlock Text="{Binding ActiveTagDocument.HeaderSize, StringFormat='{}{0} bytes'}" FontWeight="Bold" FontSize="12" Foreground="#f8fafc"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="File Size:" FontSize="10" Foreground="#64748b"/>
                                <TextBlock Text="{Binding ActiveTagDocument.FileSizeBytes, StringFormat='{}{0:N0} bytes'}" FontWeight="Bold" FontSize="12" Foreground="#fbbf24"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding ActiveTagDocument.HeaderFields}" Background="#0f1013" BorderBrush="#222630" BorderThickness="1" CornerRadius="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="tags:TagFieldDefinition">
                                <Border BorderBrush="#1c202a" BorderThickness="0,0,0,1" Padding="8,6">
                                    <Grid ColumnDefinitions="60,180,180,*">
                                        <TextBlock Grid.Column="0" Text="{Binding Offset, StringFormat='0x{0:X2}'}" FontSize="10" Foreground="#64748b" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" Foreground="#f8fafc" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" Background="#181b22" CornerRadius="3" Padding="4,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TypeName}" FontSize="10" Foreground="#38bdf8"/>
                                        </Border>
                                        <TextBox Grid.Column="3" Text="{Binding Value}" Height="26" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- TAB 2: TAG REFLEXIVES & BLOCKS -->
            <TabItem Header="🧬 Tag Reflexives">
                <Grid RowDefinitions="Auto,*" Margin="4">
                    <TextBlock Grid.Row="0" Text="Tag Blocks &amp; Reflexives (Arrays of nested Blam structures)" FontSize="11" Foreground="#94a3b8" Margin="0,0,0,8"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding ActiveTagDocument.Reflexives}" Background="#0f1013" BorderBrush="#222630" BorderThickness="1" CornerRadius="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="tags:TagReflexiveDefinition">
                                <Border BorderBrush="#1c202a" BorderThickness="0,0,0,1" Padding="10,8">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#f8fafc"/>
                                            <TextBlock Text="{Binding HeaderOffset, StringFormat='Header Offset: 0x{0:X4}'}" FontSize="9" Foreground="#64748b"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#1e293b" CornerRadius="4" Padding="8,4" Margin="6,0">
                                            <TextBlock Text="{Binding ElementCount, StringFormat='Count: {0}'}" FontSize="10" FontWeight="Bold" Foreground="#4ade80"/>
                                        </Border>
                                        <Border Grid.Column="2" Background="#1e293b" CornerRadius="4" Padding="8,4" Margin="6,0">
                                            <TextBlock Text="{Binding ElementSize, StringFormat='Size: 0x{0:X2}'}" FontSize="10" Foreground="#38bdf8"/>
                                        </Border>
                                        <Border Grid.Column="3" Background="#1e293b" CornerRadius="4" Padding="8,4" Margin="6,0">
                                            <TextBlock Text="{Binding ElementDataOffset, StringFormat='Data: 0x{0:X4}'}" FontSize="10" Foreground="#fbbf24"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <!-- TAB 3: SCENARIO INSTANCE DATA -->
            <TabItem Header="🎭 Scenario Placement Reflexives">
                <Grid ColumnDefinitions="*,*,*" Margin="4">
                    <!-- Spawns -->
                    <Border Grid.Column="0" Background="#181b22" CornerRadius="4" Padding="8" Margin="0,0,4,0">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <TextBlock Grid.Row="0" Text="Player Starting Locations" FontWeight="Bold" FontSize="11" Foreground="#38bdf8"/>
                            <Button Grid.Row="1" Command="{Binding AddSpawnCommand}" Content="+ Add Spawn" Margin="0,4,0,6"/>
                            <ListBox Grid.Row="2" ItemsSource="{Binding Spawns}" Background="#0f1013">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#1c202a" BorderThickness="0,0,0,1" Padding="4">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding Position, StringFormat='Pos: ({0:F0})'}" FontSize="10" Foreground="#f8fafc"/>
                                                <TextBlock Text="{Binding FacingAngle, StringFormat='Facing: {0:F0}°'}" FontSize="9" Foreground="#94a3b8"/>
                                                <TextBlock Text="{Binding TeamDesignator, StringFormat='Team: {0}'}" FontSize="9" Foreground="#4ade80"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Equipment -->
                    <Border Grid.Column="1" Background="#181b22" CornerRadius="4" Padding="8" Margin="2,0">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <TextBlock Grid.Row="0" Text="Netgame Equipment" FontWeight="Bold" FontSize="11" Foreground="#38bdf8"/>
                            <Button Grid.Row="1" Command="{Binding AddEquipmentCommand}" Content="+ Add Equipment" Margin="0,4,0,6"/>
                            <ListBox Grid.Row="2" ItemsSource="{Binding Equipment}" Background="#0f1013">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#1c202a" BorderThickness="0,0,0,1" Padding="4">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding ItemTagPath}" FontSize="9" FontWeight="SemiBold" Foreground="#f8fafc"/>
                                                <TextBlock Text="{Binding Position, StringFormat='Pos: ({0:F0})'}" FontSize="9" Foreground="#94a3b8"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Trigger Volumes -->
                    <Border Grid.Column="2" Background="#181b22" CornerRadius="4" Padding="8" Margin="4,0,0,0">
                        <Grid RowDefinitions="Auto,Auto,*">
                            <TextBlock Grid.Row="0" Text="Trigger &amp; Kill Volumes" FontWeight="Bold" FontSize="11" Foreground="#38bdf8"/>
                            <Button Grid.Row="1" Command="{Binding AddKillVolumeCommand}" Content="+ Add Kill Volume" Margin="0,4,0,6"/>
                            <ListBox Grid.Row="2" ItemsSource="{Binding Volumes}" Background="#0f1013">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#1c202a" BorderThickness="0,0,0,1" Padding="4">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="10" Foreground="#f8fafc"/>
                                                <TextBlock Text="{Binding VolumeType, StringFormat='Type: {0}'}" FontSize="9" Foreground="#ef4444"/>
                                                <TextBlock Text="{Binding Position, StringFormat='Pos: ({0:F0})'}" FontSize="9" Foreground="#94a3b8"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 3. FOOTER STATUS BAR -->
        <Border Grid.Row="2" Background="#101216" Padding="12,4" BorderBrush="#1e222a" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="10" Foreground="#94a3b8"/>
                <TextBlock Grid.Column="1" Text="Halo 3 Guerilla Engine Introspection" FontSize="9" Foreground="#64748b"/>
            </Grid>
        </Border>
    </Grid>
</Window>
